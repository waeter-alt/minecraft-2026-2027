<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        size="190 244"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" size="190 244"/>
    <text id="title" size="160 11" pos="15 14" color="black" textalign="MIDDLE" label="Registre de l'entrepôt"/>
    <input id="search" size="160 18" pos="15 30" maxlength="25"/>
    <list id="stock" size="165 156" pos="15 55">
        <box size="100% 18" linewidth="1">
            <itemicon id="icon" size="17 17" pos="0 0"/>
            <text id="name" size="76 12" pos="20 3" color="black"/>
            <text id="count" size="22 18" pos="97 4" color="black"/>
            <button id="takeOne" size="14 15" pos="119 1" color="black"
                    source="minecolonies:textures/gui/builderhut/builder_button_mini.png" label="1"/>
            <button id="takeStack" size="18 15" pos="134 1" color="black"
                    source="minecolonies:textures/gui/builderhut/builder_button_mini.png" label="64"/>
        </box>
    </list>
    <button id="deposit" size="86 17" pos="8 215" color="black"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png" label="Tout déposer"/>
    <button id="back" size="86 17" pos="96 215" color="black"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png" label="Retour"/>
</window>
