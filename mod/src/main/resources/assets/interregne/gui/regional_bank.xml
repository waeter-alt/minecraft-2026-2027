<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        size="190 224"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" size="190 224"/>
    <text id="title" size="160 11" pos="15 14" color="black" textalign="MIDDLE" label="Banque régionale"/>
    <text id="colony" size="160 11" pos="15 26" color="gray" textalign="MIDDLE" label=""/>
    <text id="level" size="160 11" pos="15 40" color="black" textalign="MIDDLE" label=""/>
    <text id="balance" size="160 11" pos="15 52" color="black" textalign="MIDDLE" label=""/>
    <text id="hint" size="160 11" pos="15 64" color="gray" textalign="MIDDLE" label="Dépensé par les chantiers et l'Intendance"/>

    <button id="deposit" size="160 17" pos="15 78" color="black"
            source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png" label="Déposer toutes mes couronnes"/>

    <text id="withdrawLabel" size="160 11" pos="15 101" color="black" textalign="MIDDLE" label="Retirer du trésor"/>
    <view id="withdrawPanel" size="160 40" pos="15 114">
        <button id="take10" size="38 17" pos="0 0" color="black"
                source="minecolonies:textures/gui/builderhut/builder_button_mini.png" label="10"/>
        <button id="take100" size="38 17" pos="41 0" color="black"
                source="minecolonies:textures/gui/builderhut/builder_button_mini.png" label="100"/>
        <button id="take1000" size="38 17" pos="82 0" color="black"
                source="minecolonies:textures/gui/builderhut/builder_button_mini.png" label="1 000"/>
        <button id="take10000" size="38 17" pos="123 0" color="black"
                source="minecolonies:textures/gui/builderhut/builder_button_mini.png" label="10 000"/>
        <input id="amount" size="98 18" pos="0 21" maxlength="12"/>
        <button id="takeAmount" size="58 17" pos="102 22" color="black"
                source="minecolonies:textures/gui/builderhut/builder_button_mini.png" label="Retirer"/>
    </view>
    <text id="managerOnly" size="160 22" pos="15 118" color="gray" textalign="MIDDLE"
          label="Seuls le propriétaire et les officiers retirent ou améliorent la banque."/>

    <text id="upgradeInfo" size="160 11" pos="15 159" color="black" textalign="MIDDLE" label=""/>
    <button id="upgrade" size="160 17" pos="15 172" color="black"
            source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png" label="Améliorer la banque"/>

    <button id="close" size="86 17" pos="52 198" color="black"
            source="minecolonies:textures/gui/builderhut/builder_button_medium.png" label="Fermer"/>
</window>
